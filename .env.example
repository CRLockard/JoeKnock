# Root/environment defaults for JoeKnock scaffold

# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/joeknock_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/joeknock_test
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Provider requests are bounded, cached in-process and paced across API instances
# sharing the database. Set an identifying app/contact value before deployment.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=JoeKnock/0.1 property-resolution
GEOCODING_TIMEOUT_MS=5000

# Development-only seeded auth account
DEV_SEED_ORGANIZATION_NAME=JoeKnock Development Org
DEV_SEED_ORGANIZATION_TIMEZONE=UTC
DEV_SEED_ADMIN_FIRST_NAME=Dev
DEV_SEED_ADMIN_LAST_NAME=Admin
DEV_SEED_ADMIN_EMAIL=dev-admin@example.com
DEV_SEED_ADMIN_PASSWORD=DevAdminPass123!

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
